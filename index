  let lo=Infinity,hi=-Infinity;
  for(const c of cs){lo=Math.min(lo,c.l);hi=Math.max(hi,c.h);}
  if(!(hi-lo>Math.abs(hi)*1e-7)){hi=hi+1;lo=lo-1;}
  const pad=(hi-lo)*.06;return{lo:lo-pad,hi:hi+pad};
}
function makeYMap(dom,height){const k=height/(dom.hi-dom.lo);
  return{y:p=>(p-dom.lo)*k+.6,k:k,dom:dom};}
function niceTicks(lo,hi,n){
  n=n||5;const span=hi-lo;if(!(span>0))return[lo];
  const raw=span/n,mag=Math.pow(10,Math.floor(Math.log10(raw))),norm=raw/mag;
  const step=(norm<1.5?1:norm<3?2:norm<7?5:10)*mag;
  const out=[];for(let t=Math.ceil(lo/step)*step;t<=hi+1e-9;t+=step)out.push(+t.toFixed(6));
  return out;
}
function tickBeat(d,base,o,newHi,newLo){
  const mag=Math.abs(d)/Math.max(base,Math.abs((o||1))*1e-5);
  const who=d>=0?'bull':'bear';
  if(mag<.25)return{kind:'feint',who:who,mag:mag};
  if((newHi||newLo)&&mag>1.1)return{kind:'matrix',who:who,mag:mag,up:!!newHi};
  return{kind:'strike',who:who,mag:mag};
}
