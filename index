let lastT=performance.now(),fC=0,fT=0;
function frame(now){
  requestAnimationFrame(frame);
  let rdt=(now-lastT)/1000;lastT=now;
  if(rdt>0.06)rdt=0.06;
  fC++;fT+=rdt;
  if(fT>=.5){U.el('fps').textContent=Math.round(fC/fT)+' FPS · '+world.hits+' HITS';fC=0;fT=0;}
  if(world.paused){Cam.update(rdt);renderer.render(scene,Cam.cam);return;}
  world.ts+=(world.tsT-world.ts)*Math.min(1,rdt*6);
  const sdt=rdt*world.speed*world.skipBoost*world.ts;
  world.t+=sdt;
  world.rt=world.rt.filter(a=>{a.t-=rdt;if(a.t<=0){try{a.fn();}catch(e){console.error(e);}return false;}return true;});
  try{
    Dir.update(sdt,rdt);
    Fighters.update(sdt);
    Tweens.update(sdt);
    FX.update(sdt);
    Chart.update();
    LiveForm.update();
    RingStage.update();
    ClipCaption.update();
    Cam.update(sdt);
  }catch(e){
    console.error(e);
    if(window.__bfBanner)window.__bfBanner('RUNTIME ERROR: '+e.message);
  }
  HUD.updateFloaters(rdt);
  if((Dir.state==='bout'||Dir.state==='tut')&&LiveFight.t0!=null)
    U.el('countdown').textContent='CLOSES IN '+fmtMMSS(LiveFight.t0+60-Date.now()/1000);
  if(Clip.rec&&Clip.mode==='bout'&&Date.now()-Clip.t0>100000)Clip.stop();
  try{renderer.render(scene,Cam.cam);}
  catch(e){console.error(e);if(window.__bfBanner)window.__bfBanner('RENDER ERROR: '+e.message);}
}

/* ── embedded self-test suite (press T) ── */
const Tests={run(){
  const R=[];
  const asrt=(n,f)=>{try{f();R.push([n,1,'']);}catch(e){R.push([n,0,String(e.message||e)]);}};
  const ok=(c,m)=>{if(!c)throw new Error(m||'assert failed');};
  const eq=(a,b,m)=>{if(JSON.stringify(a)!==JSON.stringify(b))throw new Error((m||'eq')+' :: '+JSON.stringify(a)+' ≠ '+JSON.stringify(b));};
  const kr={error:[],result:{XXBTZUSD:[[1000,'100','110','95','105','102',500,10],[2000,'105','108','101','107','106',300,8]],last:2000}};
  const cb=[[2000,95,110,100,105,500],[1000,90,102,92,100,400]];
  asrt('kraken parser',()=>{const r=parseKraken(kr,600,3000);eq(r.length,2);eq(r[0].o,100);eq(r[1].cl,107);});
  asrt('coinbase parser (sort+shape)',()=>{const r=parseCoinbase(cb,600,3000);eq(r[0].t,1000);eq(r[1].h,110);});
  asrt('closed-candle filter',()=>{eq(parseKraken(kr,600,2500).length,1);});
  asrt('kraken odd pair key',()=>{const j={error:[],result:{SOLUSD:[[10,'1','2','0.5','1.5','',9,3]],last:0}};
    eq(parseKraken(j,60,999)[0].cl,1.5);});
  asrt('synth tape sanity',()=>{const t=synthTape('BTC',16,60);ok(t.length===16);
    for(const c of t)ok(c.h>=Math.max(c.o,c.cl)-1e-9&&c.l<=Math.min(c.o,c.cl)+1e-9,'wick bounds');});
  asrt('tickBeat: direction picks the attacker',()=>{
    eq(tickBeat(1.2,1,100,false,false).who,'bull');
    eq(tickBeat(-1.2,1,100,false,false).who,'bear');});
  asrt('tickBeat: dead tape is a feint',()=>{eq(tickBeat(.01,1,100,false,false).kind,'feint');});
  asrt('tickBeat: fresh extreme + size = matrix moment',()=>{
    eq(tickBeat(2,1,100,true,false).kind,'matrix');
    eq(tickBeat(-2,1,100,false,true).kind,'matrix');});
  asrt('tickBeat: normal tick is a strike',()=>{eq(tickBeat(1,1,100,false,false).kind,'strike');});
  asrt('tickBeat: zero baseline never NaNs',()=>{
    const s=tickBeat(3,0,100,false,false);
    ok(isFinite(s.mag)&&s.mag>0,'finite mag on base=0');});
  asrt('tickBeat fuzz 500 ticks (property)',()=>{
    const rng=U.rng(42);
    for(let i=0;i<500;i++){
      const d=(rng()-.5)*4,base=Math.max(rng()*.2,.01);
      const s=tickBeat(d,base,100,rng()<.2,rng()<.2);
      ok(['feint','strike','matrix'].indexOf(s.kind)>=0,'known kind');
      ok(s.who==='bull'||s.who==='bear','valid attacker');
      ok(isFinite(s.mag)&&s.mag>=0,'finite mag');}
    ok(true);});
  asrt('flowNet: order-flow dominance ratio',()=>{
    eq(flowNet(9,3),.5);eq(flowNet(3,9),-.5);
    eq(flowNet(0,0),0);ok(flowNet(10,0)===1);});
  asrt('finisher ladder (tiers 1-4, rare at 5th win)',()=>{
    eq(tierFor(0),0);eq(tierFor(1),1);eq(tierFor(2),2);eq(tierFor(3),3);
    eq(tierFor(4),4);eq(tierFor(9),4);});
  asrt('price map monotonic+bounded',()=>{
    const cs=[{o:100,h:112,l:98,cl:108,v:1},{o:108,h:110,l:100,cl:101,v:1}];
    const dom=priceDomain(cs),m=makeYMap(dom,15);
    ok(m.y(100)<m.y(110));
    for(let p=dom.lo;p<=dom.hi;p+=(dom.hi-dom.lo)/50)ok(m.y(p)>=.5&&m.y(p)<=16,'y bound');});
  asrt('nice ticks in range',()=>{
    const t=niceTicks(97.2,131.7,5);
    ok(t.length>=3&&t.length<=8);
    for(const v of t)ok(v>=97.2&&v<=131.7,'tick range');});
  asrt('fmt: separators & NaN guard',()=>{
    ok(U.fmt(64981.2).includes(','),'thousands sep');eq(U.fmt(NaN),'—');});
  asrt('rng determinism + bounds',()=>{
    const a=U.rng(5),b=U.rng(5);
    for(let i=0;i<500;i++){const v=a();ok(v>=0&&v<1,'rng range');eq(v,b(),'rng determinism');}});
  asrt('hash stability',()=>eq(U.hash('BTC|1700'),U.hash('BTC|1700')));
  let pass=0,fail=0;
  const list=U.el('testList');list.innerHTML='';
  for(const[n,okF,msg]of R){
    if(okF)pass++;else fail++;
    const d=document.createElement('div');d.className='tr '+(okF?'ok':'bad');
    d.innerHTML='<b>'+(okF?'✓':'✗')+'</b><span>'+n+(msg?' — '+msg:'')+'</span>';
    list.appendChild(d);
  }
  U.el('testHead').textContent='SELFCHECK '+pass+'/'+(pass+fail);
  return{pass:pass,fail:fail};
}};

/* ── boot (runs once the CDN loader resolves the engine) ── */
window.__startApp=function(){
  if(!window.THREE){
    if(window.__bfBanner)window.__bfBanner('3D ENGINE OFFLINE — three.js failed from every CDN. Place three.min.js (r128) beside this file and add it as the first entry of the loader chain.');
    try{
      const tr=Tests.run();
      Log.feed('TEST',tr.fail?'SELFCHECK FAILING':'SELFCHECK '+tr.pass+'/'+(tr.pass+tr.fail)+' PASS (logic only — no 3D engine)');
    }catch(e){}
    window.__BF_BOOTED=true;
    return;
  }
  try{
    initGL();Cam.init();FX.init();Chart.init();LiveForm.init();
    RingStage.init();ClipCaption.init();
    Fighters.init();HUD.init();Mini.init();
    wireUI();
    const tr=Tests.run();
    Log.feed('TEST',tr.fail?('SELFCHECK: '+tr.fail+' FAILING — press T'):'SELFCHECK '+tr.pass+'/'+(tr.pass+tr.fail)+' PASS — press T for the panel');
    App.loadTape();
    MiniPoll.start();
    Flow.connect();
    setInterval(volumeWatch,10000);
    requestAnimationFrame(frame);
    if(window.lucide&&window.lucide.createIcons)window.lucide.createIcons();
    window.__BF_BOOTED=true;
  }catch(e){
    console.error(e);
    if(window.__bfBanner)window.__bfBanner('BOOT FAILURE: '+e.message);
  }
};
window.__MAIN_READY=true;
if(window.__THREE_DONE)window.__startApp();
</script>
