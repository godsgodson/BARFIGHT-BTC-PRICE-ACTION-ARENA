const Mini={
  cvs:null,ctx:null,buf:[],lastDir:0,w:300,h:46,
  init(){this.cvs=U.el('miniC');this.ctx=this.cvs.getContext('2d');this.resize();},
  resize(){
    const d=Math.min(devicePixelRatio||1,2),r=this.cvs.getBoundingClientRect();
    this.w=Math.max(60,r.width);this.h=Math.max(20,r.height);
    this.cvs.width=this.w*d;this.cvs.height=this.h*d;
    this.ctx.setTransform(d,0,0,d,0,0);this.draw();
  },
  reset(){this.buf.length=0;U.el('bigP').textContent='—';U.el('bigP').className='bigp';U.el('miniD').textContent='';this.draw();},
  push(p){
    if(!isFinite(p))return;
    const prev=this.buf.length?this.buf[this.buf.length-1]:p;
    this.lastDir=p>=prev?1:-1;
    this.buf.push(p);if(this.buf.length>90)this.buf.shift();
    const bp=U.el('bigP');
    bp.textContent=U.fmt(p);
    bp.className='bigp '+(p>=prev?'up':'dn');
    if(this.buf.length>1){
      const pc=(p-this.buf[0])/this.buf[0]*100,e=U.el('miniD');
      e.textContent=(pc>=0?'+':'')+pc.toFixed(2)+'%';
      e.style.color=pc>=0?'var(--grn)':'var(--red)';
    }
    LiveFight.tick(p);
    this.draw();
  },
  draw(){
    const c=this.ctx;if(!c)return;
    c.clearRect(0,0,this.w,this.h);
    c.font='600 8px "IBM Plex Mono", monospace';
    if(this.buf.length<2){c.fillStyle='#565b62';c.fillText('AWAITING 1S TAPE…',6,14);return;}
    let lo=Infinity,hi=-Infinity;
    for(const p of this.buf){lo=Math.min(lo,p);hi=Math.max(hi,p);}
    const rlo=lo,rhi=hi,pad=(hi-lo)*.12||Math.max(hi*.0005,1e-9);
    lo-=pad;hi+=pad;
    const X=i=>4+(this.w-8)*i/(this.buf.length-1);
    const Y=p=>this.h-6-(this.h-18)*(p-lo)/(hi-lo);
    c.strokeStyle='#2a2f36';c.beginPath();c.moveTo(0,this.h-4.5);c.lineTo(this.w,this.h-4.5);c.stroke();
    c.strokeStyle='#ece7db';c.lineWidth=1.2;c.beginPath();
    this.buf.forEach((p,i)=>{i?c.lineTo(X(i),Y(p)):c.moveTo(X(0),Y(p));});
    c.stroke();
    c.fillStyle=this.lastDir>=0?'#3ddc84':'#ff5a4a';
    c.beginPath();c.arc(X(this.buf.length-1),Y(this.buf[this.buf.length-1]),2.6,0,6.283);c.fill();
    c.fillStyle='#6f757e';
    c.fillText('LO '+U.fmt(rlo),4,this.h-1);
    c.textAlign='right';c.fillText('HI '+U.fmt(rhi),this.w-4,9);c.textAlign='left';
  }
};
