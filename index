    U.el('shVideo').src=this.url;
    U.el('shSize').textContent=(blob.size/1048576).toFixed(1)+' MB · '+this.ext.toUpperCase();
    let canShare=false;
    try{
      const f=new File([blob],'barfight.'+this.ext,{type:blob.type});
      canShare=!!(navigator.canShare&&navigator.canShare({files:[f]}));
    }catch(e){}
    U.el('shShare').style.display=canShare?'inline-flex':'none';
