const Clip={
  rec:null,chunks:[],mode:null,t0:0,dest:null,discard:false,mime:'video/webm',
  available(){return !!(window.MediaRecorder&&renderer&&renderer.domElement.captureStream);},
  start(mode){
    if(this.rec||!this.available())return;
    try{
      const stream=renderer.domElement.captureStream(30);
      if(SFX.ctx&&!SFX.muted){
        this.dest=SFX.ctx.createMediaStreamDestination();
        SFX.out.connect(this.dest);
        for(const t of this.dest.stream.getAudioTracks())stream.addTrack(t);
      }
      const mime=['video/webm;codecs=vp9','video/webm;codecs=vp8','video/webm','video/mp4']
        .find(m=>MediaRecorder.isTypeSupported(m));
      this.rec=new MediaRecorder(stream,mime?{mimeType:mime,videoBitsPerSecond:5e6}:undefined);
      this.mime=mime||'video/webm';
      this.chunks=[];
      this.discard=false;
      this.rec.ondataavailable=e=>{if(e.data&&e.data.size)this.chunks.push(e.data);};
      this.rec.onstop=()=>this.finish();
      this.rec.start(500);
      this.mode=mode||'manual';this.t0=Date.now();
      U.el('recTag').classList.add('on');
      U.el('btnClip').classList.add('on');
      U.el('clipLbl').textContent='STOP CLIP';
      Log.feed('UI','clip recording — '+(mode==='bout'?'auto-stops after the verdict':'manual'));
    }catch(e){
      Log.feed('UI','recorder failed: '+e.message);
      this.rec=null;
    }
  },
  stop(){if(!this.rec)return;try{this.rec.stop();}catch(e){}},
  cancel(){if(!this.rec)return;this.discard=true;this.stop();},
  finish(){
    const mode=this.mode||'manual';this.mode=null;
    this.rec=null;
    U.el('recTag').classList.remove('on');
    U.el('btnClip').classList.remove('on');
    U.el('clipLbl').textContent='CLIP BOUT';
    if(this.dest){try{SFX.out.disconnect(this.dest);}catch(e){}this.dest=null;}
    ClipCaption.spr.visible=false;
    if(this.discard){this.chunks=[];return;}
    if(!this.chunks.length){Log.feed('UI','clip empty — nothing recorded');return;}
    Share.show(new Blob(this.chunks,{type:this.mime}));
  }
};
const Share={
  blob:null,url:null,ext:'webm',
  show(blob){
    this.cleanup();
    this.blob=blob;
    this.ext=(blob.type||'').indexOf('mp4')>=0?'mp4':'webm';
