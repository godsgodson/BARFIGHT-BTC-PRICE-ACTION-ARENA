async function fetchLiveTape(pairKey,histN){
  const A=ASSETS[pairKey],now=Date.now()/1000;
  try{
    const j=await fetchJSON('https://api.kraken.com/0/public/OHLC?pair='+A.kr+'&interval=1',5000);
    const all=parseKrakenAll(j);
    const closed=all.filter(r=>r.t+60<=now+5);
    if(closed.length>=Math.min(histN,3)){
