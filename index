    Log.feed('UI','bout clip ready — '+(blob.size/1048576).toFixed(1)+' MB');
  },
  cleanup(){if(this.url){try{URL.revokeObjectURL(this.url);}catch(e){}this.url=null;}},
  close(){this.cleanup();U.el('sharecard').classList.remove('show');},
  download(){
    if(!this.url)return;
    const a=document.createElement('a');
    a.href=this.url;
    a.download='barfight_'+App.pair+'_bout'+Dir.bouts+'.'+this.ext;
    document.body.appendChild(a);a.click();a.remove();
  },
  async native(){
    try{
      const file=new File([this.blob],'barfight.'+this.ext,{type:this.blob.type});
      if(navigator.canShare&&navigator.canShare({files:[file]}))
        await navigator.share({files:[file],title:'BARFIGHT',text:'Bull vs bear on the live tape — '+Chart.pairLabel});
    }catch(e){}
  }
};

/* ── live strikes ── */
let Round=null;
function pickMove(mag){
  const F=mag>2.2?['superman','spin','uppercut','haymaker']
    :mag>1.2?['hook','kick','elbow','haymaker','pushkick','sweep']
    :mag>.6?['cross','pushkick','kick','elbow','hook']
    :['jab','cross','jab','elbow'];
  const pool=F.filter(m=>m!==LiveFight.lastMove);
  const mv=pool[Math.floor(Math.random()*pool.length)]||F[0];
  LiveFight.lastMove=mv;
  return mv;
}
function liveStrike(spec,p){
  const A=Fighters.get(spec.who),D=Fighters.get(spec.who==='bull'?'bear':'bull');
  const surge=LiveFight.surge>0;
  let mag=spec.mag*(surge?1.6:1);
  if(surge)mag=Math.max(mag,1.6);
  const move=pickMove(mag);
  let pwr=U.clamp(.6+mag*.45,.6,1.7);
  if((Dir.power[spec.who]||0)>60)pwr+=.25;
  if(surge)pwr+=.3;
