  finally{clearTimeout(to);}
}
function parseKrakenAll(j){
  if(!j||!j.result)throw new Error('kraken: no result');
  if(j.error&&j.error.length)throw new Error('kraken: '+String(j.error).slice(0,40));
  const res=j.result,key=Object.keys(res).find(k=>k!=='last');
  if(!key)throw new Error('kraken: no series');
  const out=[];for(const r of res[key])
    out.push({t:+r[0],o:+r[1],h:+r[2],l:+r[3],cl:+r[4],v:+r[6]});
  out.sort((a,b)=>a.t-b.t);return out;
}
function parseKraken(j,G,now){return parseKrakenAll(j).filter(r=>r.t+G<=now+5);}
function parseCoinbase(j,G,now){
  if(!Array.isArray(j))throw new Error('cb: bad shape');
  const out=[];for(const r of j){let t,l,h,o,cl,v;
    if(Array.isArray(r)){[t,l,h,o,cl,v]=r;}
    else if(r&&r.start){t=r.start;l=r.low;h=r.high;o=r.open;cl=r.close;v=r.volume;}
    else continue;
    if(t+G>now+5)continue;
    out.push({t:+t,o:+o,h:+h,l:+l,cl:+cl,v:+v});}
  out.sort((a,b)=>a.t-b.t);return out;
}
function synthTape(assetKey,n,G){
  const base={BTC:64000,ETH:3200,SOL:142}[assetKey]||100;
  const rng=U.rng(U.hash('sim'+assetKey+n));let p=base;
  const now=Math.floor(Date.now()/1000/G)*G,out=[];
  for(let i=n;i>=1;i--){const t=now-i*G;
    const o=p,cl=o+(rng()-.485)*base*.0011;
    const h=Math.max(o,cl)+rng()*base*.0004,l=Math.min(o,cl)-rng()*base*.0004;
    out.push({t:t,o:o,h:h,l:l,cl:cl,v:2+rng()*9});p=cl;}
  return out;
}
