/* ── FX ── */
const FX={S:null,D:null,rings:[],
  VS:'attribute float aSize;attribute float aAlpha;attribute vec3 aCol;varying float vA;varying vec3 vC;void main(){vC=aCol;vA=aAlpha;vec4 mv=modelViewMatrix*vec4(position,1.0);gl_PointSize=aSize*(180.0/max(1.0,-mv.z));gl_Position=projectionMatrix*mv;}',
  FR_SPARK:'precision mediump float;varying float vA;varying vec3 vC;void main(){vec2 q=gl_PointCoord*2.0-1.0;float m=smoothstep(1.0,0.1,abs(q.x)+abs(q.y)*0.75);if(m*vA<0.02)discard;gl_FragColor=vec4(vC*(1.2+vA*0.6),vA*m);}',
  FR_DUST:'precision mediump float;varying float vA;varying vec3 vC;void main(){vec2 q=gl_PointCoord*2.0-1.0;float m=smoothstep(1.0,0.0,length(q));if(m*vA<0.02)discard;gl_FragColor=vec4(vC,vA*m*0.45);}',
  init(){
    const mk=(n,frag,blend)=>{
      const g=new THREE.BufferGeometry();
      g.setAttribute('position',new THREE.BufferAttribute(new Float32Array(n*3),3));
      g.setAttribute('aCol',new THREE.BufferAttribute(new Float32Array(n*3),3));
      g.setAttribute('aSize',new THREE.BufferAttribute(new Float32Array(n),1));
      g.setAttribute('aAlpha',new THREE.BufferAttribute(new Float32Array(n),1));
      const m=new THREE.ShaderMaterial({transparent:true,depthWrite:false,blending:blend,vertexShader:this.VS,fragmentShader:frag});
      const pts=new THREE.Points(g,m);pts.frustumCulled=false;scene.add(pts);
      return{g:g,n:n,cursor:0,data:Array.from({length:n},()=>({life:0,decay:1,vel:new THREE.Vector3(),size:0,grav:0,drag:0}))};
    };
    this.S=mk(460,this.FR_SPARK,THREE.AdditiveBlending);
    this.D=mk(160,this.FR_DUST,THREE.NormalBlending);
  },
  _spawn(sys,pos,vel,colHex,size,life,grav,drag){
    const i=(sys.cursor=(sys.cursor+1)%sys.n),d=sys.data[i],a=sys.g.attributes;
    d.life=life;d.decay=1/life;d.vel.copy(vel);d.size=size;d.grav=grav;d.drag=drag;
    a.position.setXYZ(i,pos.x,pos.y,pos.z);
    const c=new THREE.Color(colHex);a.aCol.setXYZ(i,c.r,c.g,c.b);
    a.aSize.setX(i,size);a.aAlpha.setX(i,1);
  },
  spark(pos,n,colHex,speed){
    for(let k=0;k<n;k++){
      const v=V3(Math.random()-.5,Math.random()*.75,Math.random()-.5).normalize().multiplyScalar((speed||6)*(.4+Math.random()*.8));
      this._spawn(this.S,pos,v,colHex||0xffffff,.5+Math.random()*.9,.5+Math.random()*.5,9,1.2);
    }
  },
  dust(pos,n){
    for(let k=0;k<n;k++){
      const v=V3((Math.random()-.5)*1.3,.6+Math.random()*.9,(Math.random()-.5)*1.3);
      this._spawn(this.D,pos,v,0x555a5e,1.2+Math.random()*1.4,1.1+Math.random()*.7,-.8,1.6);
    }
  },
  converge(pos,colHex,n){
    n=n||40;
    for(let k=0;k<n;k++){
      const dir=V3(Math.random()-.5,Math.random()-.5,Math.random()-.5).normalize();
      const dist=2+Math.random()*1.6;
      this._spawn(this.S,V3(pos.x+dir.x*dist,pos.y+dir.y*dist,pos.z+dir.z*dist),dir.clone().multiplyScalar(-dist/.5),colHex,.4+Math.random()*.6,.5,0,0);
    }
  },
  ring(pos,colHex,maxR,dur){
    const m=new THREE.Mesh(new THREE.TorusGeometry(1,.05,8,64),
      new THREE.MeshBasicMaterial({color:colHex,transparent:true,opacity:.85,blending:THREE.AdditiveBlending,depthWrite:false}));
    m.rotation.x=-Math.PI/2;m.position.copy(pos);m.scale.setScalar(.25);scene.add(m);
    this.rings.push({m:m,t:0,dur:dur||.5,maxR:maxR||3});
  },
  update(dt){
    for(const sys of[this.S,this.D]){
      const a=sys.g.attributes;
      for(let i=0;i<sys.n;i++){
        const d=sys.data[i];if(d.life<=0)continue;
        d.life-=d.decay*dt;
        if(d.life<=0){a.aAlpha.setX(i,0);a.aSize.setX(i,0);continue;}
        d.vel.y-=d.grav*dt;if(d.drag)d.vel.multiplyScalar(Math.max(0,1-d.drag*dt));
        const p=a.position;
        p.setXYZ(i,p.getX(i)+d.vel.x*dt,p.getY(i)+d.vel.y*dt,p.getZ(i)+d.vel.z*dt);
        a.aAlpha.setX(i,Math.min(1,d.life*1.6));a.aSize.setX(i,d.size*(.3+d.life*.7));
      }
      a.position.needsUpdate=true;a.aAlpha.needsUpdate=true;a.aSize.needsUpdate=true;a.aCol.needsUpdate=true;
    }
    this.rings=this.rings.filter(r=>{
      r.t+=dt;const k=U.clamp(r.t/r.dur,0,1);
      r.m.scale.setScalar(U.lerp(.25,r.maxR,U.ease.out(k)));r.m.material.opacity=.85*(1-k);
      if(k>=1){scene.remove(r.m);r.m.geometry.dispose();r.m.material.dispose();return false;}
      return true;
    });
  }
};

