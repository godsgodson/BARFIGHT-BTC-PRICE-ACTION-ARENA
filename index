/* ── LIVE FIGHT ── */
const LiveFight={
  t0:null,o:null,h:null,l:null,cl:null,prev:null,base:0,active:false,resolving:false,
  pend:null,path:[],cool:1.5,lastCamT:0,lastD:0,surge:0,_wpc:0,idleT:0,lastMove:null,
  seed(forming,rows){
    if(forming&&isFinite(forming.o)){
      this.t0=forming.t;this.o=forming.o;this.h=forming.h;this.l=forming.l;this.cl=forming.cl;
      this.prev=this.cl;this.path=[this.o];this.base=Math.abs(this.o)*2e-5||.01;
      LiveForm.setLive(this);
    }else if(rows&&rows.length){
      const min=Math.floor(Date.now()/1000/60)*60;
      this.begin(min,rows[rows.length-1].cl);
    }else this.t0=null;
  },
  begin(min,p){
    this.t0=min;this.o=p;this.h=p;this.l=p;this.cl=p;this.prev=p;
    this.path=[p];this.cool=1.2;this.base=Math.abs(p)*2e-5||.01;
    LiveForm.setLive(this);
  },
  tick(p){
    if(!isFinite(p))return;
    const min=Math.floor(Date.now()/1000/60)*60;
    if(this.resolving){
      if(!this.pend||this.pend.t!==min)this.pend={t:min,o:p,h:p,l:p,cl:p};
      else{this.pend.cl=p;this.pend.h=Math.max(this.pend.h,p);this.pend.l=Math.min(this.pend.l,p);}
      return;
    }
    if(this.t0==null){this.begin(min,p);return;}
    if(min>this.t0){
      if(Dir.state==='bout')this.close();
      else this.begin(min,p);
      return;
    }
    const d=p-this.prev;
    const newHi=p>this.h+1e-12,newLo=p<this.l-1e-12;
    this.cl=p;if(newHi)this.h=p;if(newLo)this.l=p;
    this.path.push(p);if(this.path.length>90)this.path.shift();
    this.lastD=d;
    LiveForm.setLive(this);
    HUD.livePath();
    if(this.active)this.beat(d,p,newHi,newLo);
    if(this.surge>0)this.surge-=1;
    if(Dir.specialCool>0){
      Dir.specialCool-=1;
      Dir.power.bull=Math.max(0,Dir.power.bull-1.5);
      Dir.power.bear=Math.max(0,Dir.power.bear-1.5);
      HUD.power();
    }
    if(!Flow.ok){if(d>0)Flow.dBuy+=Math.abs(d);else if(d<0)Flow.dSell+=Math.abs(d);}
    Flow.decay();
    const net=flowNet(Flow.dBuy,Flow.dSell);
    const meaningful=Flow.ok?((Flow.dBuy+Flow.dSell)>.1):((Flow.dBuy+Flow.dSell)>this.base*3);
    if(meaningful&&Math.abs(net)>.45)Dir.addPower(net>0?'bull':'bear',5);
    if(this._wpc>0)this._wpc-=1;
    if(!Flow.ok&&Math.abs(d)>7*this.base&&this._wpc<=0){
      this._wpc=10;
      const who=d>0?'bull':'bear';
      Dir.addPower(who,8);
      HUD.float(Fighters.get(who).notice(),'LARGE PRINT','vol');
      FX.spark(Fighters.get(who).chest(),14,0xd8a94e,6);
    }
    this.base+=(Math.abs(d)-this.base)*.12;
    this.prev=p;
  },
  beat(d,p,newHi,newLo){
    if(world.t-this.lastCamT>3.5){Cam.cue(fightShotLive());this.lastCamT=world.t;}
    if(this.cool>0){this.cool-=1;this.idleT+=1;return;}
    const spec=tickBeat(d,this.base,this.o,newHi,newLo);
    if(spec.kind==='feint'){
      this.idleT+=1;
      if(this.idleT>4){
        this.idleT=0;this.cool=2.5;
        liveFlourish(Math.random()<.5?'bull':'bear');
        return;
      }
      this.cool=1.4+Math.random()*1.2;
      if(Math.random()<.5)return;
      liveFeint(spec);return;
    }
    this.idleT=0;
    this.cool=U.clamp((this.surge>0?1.6:2.2)/spec.mag,1.1,2.6)+Math.random()*.5;
    if(spec.kind==='matrix'){liveMatrix(spec);return;}
    liveStrike(spec,p);
  },
  close(){
    this.resolving=true;this.active=false;
    const tracked={t:this.t0,o:this.o,h:this.h,l:this.l,cl:this.cl,v:1};
    this.t0=null;this.pend=null;
    (async()=>{
      let closed=tracked;
      if(Feed.tape!=='OFFLINE SIM'){
        try{
          const j=await fetchJSON('https://api.kraken.com/0/public/OHLC?pair='+ASSETS[App.pair].kr+'&interval=1',4500);
          const m=parseKrakenAll(j).find(r=>r.t===tracked.t);
          if(m)closed=m;
        }catch(e){Log.feed('FEED','close fetch failed — verdict from tracked spot tape');}
      }
      Dir.run(resolveSeq(closed));
    })();
  },
  adoptPending(){
    this.resolving=false;
    const p=this.pend;
    if(p&&Date.now()/1000<p.t+60){
      this.t0=p.t;this.o=p.o;this.h=p.h;this.l=p.l;this.cl=p.cl;this.prev=p.cl;
      this.path=[p.o];this.base=Math.abs(p.o)*2e-5||.01;
    }else{
      const min=Math.floor(Date.now()/1000/60)*60;
      const px=isFinite(Feed.cbSpot)?Feed.cbSpot:Chart.rounds[Chart.rounds.length-1].cl;
      this.begin(min,px);
    }
    this.pend=null;
    LiveForm.setLive(this);
  }
};

