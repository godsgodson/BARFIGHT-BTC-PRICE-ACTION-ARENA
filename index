/* ── ORDER FLOW — Kraken v2 WS → Coinbase WS → tick proxy ── */
const Flow={
  ws:null,src:'—',ok:false,krTries:0,cbTries:0,
  dBuy:0,dSell:0,emaSize:1e-6,whaleCool:0,cbBid:null,cbAsk:null,
  connect(){this.krTries=0;this.cbTries=0;this.tryKraken();},
  retarget(){
    if(this.ws){try{this.ws.close();}catch(e){}this.ws=null;}
    this.ok=false;this.krTries=0;this.cbTries=0;
    this.dBuy=0;this.dSell=0;this.emaSize=1e-6;this.cbBid=null;this.cbAsk=null;
    this.connect();
  },
  watchdog(ws){
    const self=this;
    setTimeout(()=>{if(self.ws===ws&&!self.ok){try{ws.close();}catch(e){}}},4000);
  },
  tryKraken(){
    if(this.ws)return;
    this.src='kraken';
    let ws;
    try{ws=new WebSocket('wss://ws.kraken.com/v2');}catch(e){this.krFail();return;}
    this.ws=ws;this.watchdog(ws);
    ws.onopen=()=>{
      try{
        ws.send(JSON.stringify({method:'subscribe',params:{channel:'trade',symbol:[ASSETS[App.pair].v2]}}));
        ws.send(JSON.stringify({method:'subscribe',params:{channel:'ticker',symbol:[ASSETS[App.pair].v2]}}));
      }catch(e){}
    };
    ws.onmessage=(ev)=>{
      try{
        const m=JSON.parse(ev.data);
        if(m.channel==='trade'&&m.data)for(const t of m.data)this.trade(t);
        else if(m.channel==='ticker'&&m.data)for(const t of m.data)
          if(t&&isFinite(+t.last)){Feed.krSpot=+t.last;Feed.st.kr='ok';}
      }catch(e){}
    };
    ws.onclose=()=>{if(this.ws===ws)this.ws=null;this.krFail();};
    ws.onerror=()=>{try{ws.close();}catch(e){}};
  },
  krFail(){
    if(this.ok){this.ok=false;this.krTries=0;setTimeout(()=>this.tryKraken(),3000);return;}
    this.krTries++;
    if(this.krTries<3)setTimeout(()=>this.tryKraken(),2500);
    else{Log.feed('FEED','kraken flow socket unreachable — trying coinbase feed');this.tryCoinbase();}
  },
  tryCoinbase(){
    if(this.ws)return;
    this.src='coinbase';
    let ws;
    try{ws=new WebSocket('wss://ws-feed.exchange.coinbase.com');}catch(e){this.cbFail();return;}
    this.ws=ws;this.watchdog(ws);
    ws.onopen=()=>{
      try{ws.send(JSON.stringify({type:'subscribe',product_ids:[ASSETS[App.pair].cb],channels:['ticker']}));}catch(e){}
    };
    ws.onmessage=(ev)=>{
      try{
        const m=JSON.parse(ev.data);
        if(m.type==='ticker'){
          if((m.side==='buy'||m.side==='sell')&&isFinite(+m.last_size))
            this.trade({side:m.side,qty:+m.last_size,price:+m.price});
          if(isFinite(+m.best_bid))this.cbBid=+m.best_bid;
          if(isFinite(+m.best_ask))this.cbAsk=+m.best_ask;
        }
      }catch(e){}
    };
    ws.onclose=()=>{if(this.ws===ws)this.ws=null;this.cbFail();};
    ws.onerror=()=>{try{ws.close();}catch(e){}};
  },
  cbFail(){
    if(this.ok){this.ok=false;this.cbTries=0;setTimeout(()=>this.tryCoinbase(),3000);return;}
    this.cbTries++;
    if(this.cbTries<3)setTimeout(()=>this.tryCoinbase(),2500);
    else{this.src='proxy';Log.feed('FEED','no flow socket reachable — tick-direction proxy active');}
  },
  trade(t){
    this.ok=true;
    U.el('ledFlow').className='led ok';
    U.el('ledFlow').title='flow: '+this.src+' websocket';
    const q=Math.max(+(t.qty||0),1e-9);
    this.emaSize+=(q-this.emaSize)*.05;
    if(t.side==='buy')this.dBuy+=q;else if(t.side==='sell')this.dSell+=q;
    if(this.whaleCool<=0&&q>Math.max(this.emaSize*8,(WHALE[App.pair]||1))){
      this.whaleCool=12;
      onWhale(t.side==='buy'?'bull':'bear',q,+(t.price||0));
    }
  },
  decay(){this.dBuy*=.94;this.dSell*=.94;if(this.whaleCool>0)this.whaleCool-=1;}
};
function onWhale(side,q,p){
  Log.feed('FEED','whale print — '+q.toFixed(2)+' '+App.pair+' @ '+U.fmt(p)+' → '+side+' flow ('+Flow.src+')');
  SFX.say('Whale print — '+q.toFixed(1)+' '+App.pair+'!');
  if(Dir.state!=='bout')return;
  Dir.addPower(side,14);
  const f=Fighters.get(side);
  HUD.float(f.notice(),'WHALE '+q.toFixed(1)+' '+App.pair,'vol');
  FX.spark(f.chest(),26,f.colHex,9);
  Cam.shake(.4);SFX.hit(1.4);
}
const VolumeWatch={cool:0};
async function volumeWatch(){
  if(Feed.tape==='OFFLINE SIM'||!Chart.avgVol)return;
  if(VolumeWatch.cool>0){VolumeWatch.cool-=10;return;}
  try{
    const j=await fetchJSON('https://api.kraken.com/0/public/OHLC?pair='+ASSETS[App.pair].kr+'&interval=1',5000);
    const all=parseKrakenAll(j);
    const min=Math.floor(Date.now()/1000/60)*60;
    const f=all.find(r=>r.t===min);
    if(!f)return;
    const elapsed=U.clamp((Date.now()/1000-min)/60,.12,1);
    const ratio=f.v/(Chart.avgVol*elapsed);
    if(ratio>=2.2){
      VolumeWatch.cool=25;
      LiveFight.surge=6;
      const net=flowNet(Flow.dBuy,Flow.dSell);
      const dom=(Flow.ok&&Math.abs(net)>.2)?(net>0?'bull':'bear'):(LiveFight.cl>=LiveFight.o?'bull':'bear');
      Dir.addPower(dom,16);
      HUD.float(V3(LiveForm.x,(LiveForm.topY||6)+2.8,0),'VOLUME SURGE ×'+ratio.toFixed(1),'vol');
      FX.dust(V3(LiveForm.x,(LiveForm.topY||6),0),14);
      FX.ring(V3(LiveForm.x,(LiveForm.topY||6)+.1,0),0xd8a94e,2.8,.5);
      SFX.hit(1.6);Cam.shake(.5);
      SFX.say('Volume surge! '+dom+' side surging!');
      Log.feed('FEED','volume surge ×'+ratio.toFixed(1)+' — surge mode, power to '+dom);
    }
  }catch(e){}
};

