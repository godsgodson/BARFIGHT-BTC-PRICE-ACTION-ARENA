/* ── chart ── */
const Chart={
  group:null,rounds:[],candles:[],yM:null,dom:null,pairLabel:'',avgVol:1,
  init(){this.group=new THREE.Group();scene.add(this.group);},
  build(rounds,resolvedDirs,pairLabel){
    while(this.group.children.length){
      const ch=this.group.children.pop();
      ch.traverse(o=>{if(o.geometry)o.geometry.dispose();
        if(o.material){if(o.material.map)o.material.map.dispose();o.material.dispose();}});
    }
    this.rounds=rounds;this.pairLabel=pairLabel||this.pairLabel;this.candles=[];
    let av=0;for(const c of rounds)av+=(c.v||0);
    this.avgVol=(av/Math.max(1,rounds.length))||1;
    const dom=priceDomain(rounds),yM=makeYMap(dom,15);
    this.yM=yM;this.dom=dom;
    const N=rounds.length;
    for(let i=0;i<N;i++){
      const c=rounds[i],x=this.candleX(i);
      const yO=yM.y(c.o),yC=yM.y(c.cl),yH=yM.y(c.h),yL=yM.y(c.l);
      const top=Math.max(yO,yC);let bot=Math.min(yO,yC);if(top-bot<.5)bot=top-.5;
      const mat=new THREE.MeshStandardMaterial({color:0x2b323a,roughness:.82,metalness:.08,
        transparent:true,opacity:.42,emissive:0x0d1013,emissiveIntensity:.5});
      const body=new THREE.Mesh(new THREE.BoxGeometry(W.candleW,top-bot,W.candleD),mat);
      body.position.set(x,(top+bot)/2,0);body.castShadow=true;body.receiveShadow=true;
      const wick=new THREE.Mesh(new THREE.BoxGeometry(.15,Math.max(.06,yH-yL),.15),mat);
      wick.position.set(x,(yH+yL)/2,0);
      this.group.add(body);this.group.add(wick);
      const cd={x:x,top:top,mat:mat,body:body,wick:wick,resolved:(resolvedDirs&&resolvedDirs[i])||0,state:'veil'};
      this.candles.push(cd);
      if(cd.resolved)this._applyState(cd,cd.resolved>0?'grn':cd.resolved<0?'red':'flat');
    }
    const ticks=niceTicks(dom.lo,dom.hi,5),chartW=(N+2)*W.spacing;
    for(const t of ticks){
      const y=yM.y(t);
      const line=new THREE.Mesh(new THREE.BoxGeometry(chartW+4,.02,.02),
        new THREE.MeshBasicMaterial({color:0x272c33,transparent:true,opacity:.55}));
      line.position.set(chartW/2,y,-W.candleD/2-.6);this.group.add(line);
      const lab=textSprite(U.fmt(t),40,'#6f757e');
      lab.position.set(-2.6,y,-W.candleD/2-.6);this.group.add(lab);
    }
    Cam.center.set(this.candleX(Math.max(0,N-1))-8,U.clamp(yM.y((dom.lo+dom.hi)/2),3,14),0);
    if(!Cam.seeded){Cam.seeded=true;Cam.cur.set(Cam.center.x-12,Cam.center.y+8,24);Cam.look.copy(Cam.center);}
    Log.feed('CHART',N+' history candles · range '+U.fmt(dom.lo)+'–'+U.fmt(dom.hi)+' · '+this.pairLabel);
  },
  candleX(i){return i*W.spacing;},
  top(i){return this.candles[i]?this.candles[i].top:1;},
  _applyState(cd,st){
    const m=cd.mat;
    if(st==='veil'){m.color.setHex(0x2b323a);m.emissive.setHex(0x0d1013);m.emissiveIntensity=.5;m.opacity=.42;}
    else if(st==='grn'){m.color.setHex(0x2fbf71);m.emissive.setHex(0x0f8c3f);m.emissiveIntensity=.55;m.opacity=1;}
    else if(st==='red'){m.color.setHex(0xe0453a);m.emissive.setHex(0x8c1a0f);m.emissiveIntensity=.55;m.opacity=1;}
    else{m.color.setHex(0x8b939c);m.emissive.setHex(0x23272b);m.emissiveIntensity=.4;m.opacity=1;}
    cd.state=st;
  },
  update(){}
};

