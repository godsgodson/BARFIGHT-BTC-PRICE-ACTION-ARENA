function textSprite(txt,px,color){
  const c=document.createElement('canvas'),font='600 '+px+'px "IBM Plex Mono", monospace';
  let ctx=c.getContext('2d');ctx.font=font;
  c.width=Math.ceil(ctx.measureText(txt).width)+16;c.height=px+18;
  ctx=c.getContext('2d');ctx.font=font;ctx.fillStyle=color;
  ctx.textBaseline='middle';ctx.textAlign='center';ctx.fillText(txt,c.width/2,c.height/2);
  const tex=new THREE.CanvasTexture(c);tex.minFilter=THREE.LinearFilter;
  const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:tex,transparent:true,depthWrite:false}));
  sp.scale.set(c.width/64,c.height/64,1);return sp;
}
