/* ── THE DIRECTOR ── */
const Dir={
  state:'idle',seq:null,wait:0,waitR:0,waitReal:false,todo:[],
  streaks:{bull:0,bear:0},finisherCount:0,bouts:0,carryWinner:null,
  power:{bull:0,bear:0},specialRunning:false,specialCool:0,specialCount:0,
  run(gen){this.seq=gen;this._adv();},
  _adv(){
    if(!this.seq)return;
    const gen=this.seq;
    let r;
    try{r=gen.next();}
    catch(e){
      console.error(e);
      if(this.seq===gen)this.seq=null;
      if(window.__bfBanner)window.__bfBanner('SEQUENCE ERROR: '+e.message);
      return;
    }
    if(r.done){
      if(this.seq===gen)this.seq=null;
      return;
    }
    const v=r.value||{};
    if(v.real){this.waitReal=true;this.waitR=v.t||0;}
    else{this.waitReal=false;this.wait=v.t||0;}
    if(v.start)v.start();
  },
  after(t,fn){this.todo.push({at:world.t+t,fn:fn});},
  clearTodo(){this.todo.length=0;world.tsT=1;},
  addPower(side,amt){
    if(this.state!=='bout')return;
    if(this.specialCool>0)amt*=.5;
    this.power[side]=U.clamp((this.power[side]||0)+amt,0,100);
    HUD.power();
    if(this.power[side]>=100&&this.specialCool<=0&&!this.specialRunning&&LiveFight.t0!=null&&
       (LiveFight.t0+60-Date.now()/1000)>8){
      this.run(specialSeq(side));
    }
  },
  update(sdt,rdt){
    for(const a of this.todo){if(!a.done&&world.t>=a.at){a.done=true;try{a.fn();}catch(e){console.error(e);}}}
    this.todo=this.todo.filter(a=>!a.done);
    if(this.seq){
      if(this.waitReal){this.waitR-=rdt*(world.skipBoost>1?5:1);if(this.waitR<=0)this._adv();}
      else{this.wait-=sdt;if(this.wait<=0)this._adv();}
    }
  },
  startBout(){this.state='bout';this.run(boutSeq());},
  begin(){
    this.state='title';Cam.mode='cinema';
    Fighters.both().forEach(f=>f.root.visible=false);
    HUD.cardTitle('LIVE FROM THE EDGE','THEY FIGHT ON THE BAR THAT IS FORMING NOW · THE CLOSE IS THE BELL');
    SFX.bell();
    SFX.say('Live, from the edge of the tape!');
    const withTut=!Tut.seen()||Tut.forced;
    this.run((function*(){
      yield{t:2.2};
      if(withTut){Tut.forced=false;yield* tutSeq();}
      else Dir.startBout();
    })());
  }
};
function* boutSeq(){
  world.skipBoost=1;Dir.clearTodo();Cam.clear();
  Dir.bouts++;
  const slot=Chart.candles.length;
  HUD.phase('BULL VS BEAR — LIVE BAR');
  HUD.roundNum(Dir.bouts);
  HUD.roundCardLive();
  HUD.countdownShow(true);
  HUD.meters();HUD.power();
  SFX.bell();SFX.say('Bout '+Dir.bouts+' — fight!');
  Cam.cue(craneLive());
  yield{t:1.6};
  if(Dir.carryWinner){
    Cam.cue(liveTransShot());
    Fighters.dropIn(Fighters.get(Dir.carryWinner==='bull'?'bear':'bull'),slot);
    const w=Fighters.get(Dir.carryWinner);
    if(!w.dead&&w.root.visible&&w.grounded)w.leapTo(slot);
    else Fighters.dropIn(w,slot);
    yield{t:1.3};
  }else{
    Fighters.both().forEach(f=>Fighters.dropIn(f,slot));
    yield{t:.55};
  }
  Cam.cue(portraitLive(-1));
  yield{t:.7};
  Cam.cue(portraitLive(1));
  yield{t:.7};
  Cam.cue(fightLive());
  HUD.cardCompact();
  LiveFight.active=true;
  Log.feed('DIR','bout '+Dir.bouts+' live — fighting on the forming bar');
}
function* resolveSeq(c){
  Dir.state='resolve';
  Dir.specialRunning=false;
  const dir=Math.sign(c.cl-c.o);
  const draw=(dir===0)||(Math.abs(c.cl-c.o)/Math.max(c.h-c.l,1e-12)<.02);
  const winner=dir>0?'bull':'bear',loser=dir>0?'bear':'bull';
  const counter=(winner==='bull')?(LiveFight.lastD<0):(LiveFight.lastD>0);
  Round={c:c,rng:U.rng(U.hash(App.pair+'|'+c.t)),
    sc:{draw:draw,winner:winner,loser:loser,counter:counter,dir:dir,pct:(c.cl-c.o)/(c.o||1)*100}};
  world.skipBoost=1;Dir.clearTodo();Cam.clear();
  LiveFight.active=false;HUD.countdownShow(false);
  HUD.phase('THE BELL — CLOSE DECIDES');
  SFX.bell();
  Log.feed('DIR','candle closed — '+(draw?'DOJI double KO':winner+' takes it'));
  if(draw){
    Cam.cue(fightLive());
    Fighters.bull.play('stagger');Fighters.bear.play('stagger');
    HUD.verdict(Round.sc,c);
    yield{t:.8};
    Fighters.bull.die(-4,4.5,5.5);Fighters.bear.die(4,4.5,-5.5);
    SFX.hit(1.4);HUD.flash(.4);Cam.shake(.5);
    LiveForm.reveal(0);
    Dir.streaks.bull=0;Dir.streaks.bear=0;HUD.meters();
    Dir.carryWinner=null;
    yield{t:2.2};
  }else{
    const tier=tierFor(Dir.streaks[winner]);
    if(tier===4)yield*(winner==='bull'?meltUp():blackSwan());
    else if(tier===3)yield*(winner==='bull'?donkeyKick():cubSquad());
    else if(tier===2)yield*(winner==='bull'?acmeRocket():redAnvil());
    else if(tier===1)yield*(winner==='bull'?moonLauncher():liquidation());
    else yield* finalBlow();
    LiveForm.reveal(dir);
    world.skipBoost=1;
    Dir.streaks[winner]++;Dir.streaks[loser]=0;HUD.meters();
    Dir.power.bull*=.6;Dir.power.bear*=.6;HUD.power();
    HUD.verdict(Round.sc,c);SFX.ko();
    Fighters.get(winner).play('victory');
    Dir.carryWinner=winner;
    yield{t:2};
  }
  world.skipBoost=1;
  if(Clip.mode==='bout')Clip.stop();
  nextBout();
}
function nextBout(){
  const rounds=Chart.rounds.concat([Round.c]);
  const dirs=Chart.candles.map(cd=>cd.resolved);
  dirs.push(Round.sc.dir||0);
  Chart.build(rounds,dirs,ASSETS[App.pair].cb);
  for(const f of Fighters.both())if(f.grounded&&!f.dead)f.baseY=slotTop(f.platform)+f.hipY;
  LiveForm.resetStage();
  LiveFight.adoptPending();
  Dir.startBout();
}
