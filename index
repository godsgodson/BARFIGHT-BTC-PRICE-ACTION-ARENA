const Tweens={list:[],
  run(fn,dur,ease,done){this.list.push({fn:fn,dur:Math.max(.01,dur),ease:ease||'inout',done:done,t:0});},
  clear(){this.list.length=0;},
  update(dt){
    const arr=this.list;this.list=[];
    for(const w of arr){
      w.t+=dt;const k=U.clamp(w.t/w.dur,0,1);
      try{w.fn(U.ease[w.ease](k));}catch(e){console.error(e);}
      if(w.t>=w.dur){try{w.done&&w.done();}catch(e){console.error(e);}}
      else this.list.push(w);
    }
  }
};

