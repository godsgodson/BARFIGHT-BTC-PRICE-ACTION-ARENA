function* liquidation(){ // bear · streak 2 — INVERTED PILEDRIVER, head-first into the pit
  const R=Fighters.bear,B=Fighters.bull;
  const top=LiveForm.topY||6;
  Dir.finisherCount++;
  HUD.moveCard('LIQUIDATION','BEAR FINISHER · 2 CANDLE STREAK','bear');
  SFX.riser();SFX.say('Liquidation!');
  FX.converge(R.chest(),R.colHex,46);
  const rx=R.x();
  Cam.cue({pos:()=>V3(rx+1.4,top+1.7,3.4),look:()=>R.chest(),dur:.9,fov:38,hand:.5});
  yield{t:.9};
  R.play('grab');B.play('held');B.grounded=false;B.autoRot=false;
  const bx0=B.x();
  Tweens.run(u=>{B.root.position.x=U.lerp(bx0,R.x()-R.side*.1,u);},.25,'out');
  yield{t:.3};
  // flip him upside down and hoist — beside the ring so the plunge hits the pit floor
  const y0=B.root.position.y,yT=top+7;
  world.dip(.3,1);SFX.whoosh();
  R.grounded=false;R.autoRot=false;R.play('lift');
  const px=R.x()+R.side*(W.candleW/2+1);
  Tweens.run(u=>{
    R.root.position.set(rx,U.lerp(y0,yT,u*.92),0);
    B.root.position.set(U.lerp(R.x()-R.side*.1,px,u),U.lerp(y0,yT,u),0);
    B.root.rotation.z=U.lerp(0,Math.PI,u);   // INVERTED — head pointing down
  },.9,'out');
  Cam.cue(pairFollowShot(R,B,1.4));
  yield{t:1,real:true};
  // the plunge
  world.tsT=.15;SFX.whoosh();
  const py=B.root.position.y;
  Tweens.run(u=>{B.root.position.y=U.lerp(py,1.1,U.ease.in(u));},.34,'in');
  yield{t:.34,real:true};
  // impact — crater in the pit
  world.tsT=1;
  HUD.flash(.9);SFX.death();SFX.hit(2.4);Cam.shake(1.1);
  FX.ring(V3(px,.06,0),R.colHex,4.6,.7);
  FX.ring(V3(px,.06,0),R.colHex,3,.5);
  FX.dust(V3(px,.3,0),28);FX.spark(V3(px,.8,0),44,R.colHex,10);
  B.die(0,-2,0);
  B.angv.set(0,0,0);B.root.rotation.z=Math.PI;
  R.play('slam');
  const ry1=R.root.position.y;
  Tweens.run(u=>{R.root.position.y=U.lerp(ry1,top+R.hipY,U.ease.in(u));},.3,'in');
  Cam.cue({pos:()=>V3(px-3.4,1.4,4.6),look:()=>V3(px,1,0),dur:1.8,fov:48,hand:1});
  yield{t:1.8};
  R.grounded=true;R.baseY=slotTop(R.platform)+R.hipY;R.autoRot=true;
}
