<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BARFIGHT — Live Price Action Arena</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Six+Caps&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0b0c0e; --panel:rgba(12,13,16,.86); --ink:#ece7db; --mut:#8b9096; --hair:#ffffff16;
  --grn:#3ddc84; --red:#ff5a4a; --gold:#d8a94e;
  --mono:'IBM Plex Mono',ui-monospace,'Courier New',monospace;
  --disp:'Six Caps',Impact,'Arial Narrow',sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden;background:#050506;color:var(--ink);font-family:var(--mono);-webkit-user-select:none;user-select:none}
#gl{position:fixed;inset:0;width:100%;height:100%;display:block}
body.manual #gl{cursor:grab}
#sysbanner{position:fixed;top:74px;left:50%;transform:translateX(-50%);z-index:60;background:#1a0d0b;
  border:1px solid #ff5a4a;color:#ff8a7d;font:500 11px var(--mono);letter-spacing:.08em;padding:10px 14px;
  max-width:84vw;display:none}
#dimmer{position:fixed;inset:0;background:#04050a;opacity:0;transition:opacity .9s;pointer-events:none;z-index:6}
.lb{position:fixed;left:0;right:0;height:66px;background:#050506;z-index:20;display:flex;align-items:center;
  justify-content:space-between;padding:0 18px;transition:transform .7s cubic-bezier(.7,0,.3,1);overflow:hidden}
.lb.top{top:0;transform:translateY(-101%)} .lb.bottom{bottom:0;transform:translateY(101%)}
.lb.on{transform:none}
.lb-left,.lb-mid,.lb-right{display:flex;align-items:center;gap:14px;min-width:0}
.brandblock{flex:none}
.wordmark{font:400 30px var(--disp);letter-spacing:.05em;color:var(--ink);line-height:1;white-space:nowrap}
.wordmark em{font-style:normal;color:var(--red)}
.wm-sub{font:500 8px var(--mono);letter-spacing:.3em;color:var(--mut);margin-top:3px;white-space:nowrap}
#phaseTag{flex:none;width:300px;font:500 9px var(--mono);letter-spacing:.2em;color:var(--mut);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#recTag{display:none;align-items:center;gap:6px;font:600 10px var(--mono);letter-spacing:.24em;color:#ff5a4a;flex:none}
#recTag.on{display:flex}
#recTag i{width:8px;height:8px;border-radius:50%;background:#ff5a4a;animation:recp 1s infinite alternate}
@keyframes recp{from{opacity:.25}to{opacity:1}}
.lb-mid{flex-direction:column;gap:2px;text-align:center}
#roundNum{font:600 13px var(--mono);letter-spacing:.28em;color:var(--ink);white-space:nowrap;min-width:170px}
#pairTag{font:500 9px var(--mono);letter-spacing:.26em;color:var(--gold);white-space:nowrap}
#modeTag{font:400 9px var(--mono);letter-spacing:.2em;color:var(--mut);white-space:nowrap}
.lb-right .tk{font:500 10px var(--mono);letter-spacing:.12em;color:var(--mut);display:flex;align-items:center;gap:6px}
.lb-right .tk b{color:var(--ink);font-weight:600}
.led{width:6px;height:6px;border-radius:50%;background:#3a3f45;flex:none}
.led.ok{background:var(--grn)} .led.err{background:var(--red)}
#lbB{gap:14px}
.ctrl-wide{flex:1;display:flex;flex-wrap:nowrap;justify-content:space-evenly;align-items:center;min-width:0}
.meters{display:flex;gap:12px;flex:none}
.meter{flex-direction:column;gap:4px;min-width:120px;justify-content:center;display:flex;border:1px solid var(--hair);padding:5px 9px}
.mrow{display:flex;justify-content:space-between;align-items:center;gap:8px}
.meter .mlab{font:600 9px var(--mono);letter-spacing:.2em;color:var(--mut)}
.meter .pips{font:600 10px var(--mono);color:#4a5056;letter-spacing:.14em}
#mBull.rdy .pips{color:var(--grn)} #mBear.rdy .pips{color:var(--red)}
#mBull.rdy2{border-color:#3ddc84aa} #mBear.rdy2{border-color:#ff5a4aaa}
.pbar{height:4px;background:#20262c;overflow:hidden}
.pbar i{display:block;height:100%;width:0;background:#2f7d55;transition:width .25s}
#mBear .pbar i{background:#8f3a32}
.pbar.full i{animation:ppulse .6s infinite alternate}
@keyframes ppulse{from{opacity:.5}to{opacity:1}}
.btn{display:inline-flex;align-items:center;gap:7px;background:transparent;border:1px solid var(--hair);color:var(--mut);
  font:500 10px var(--mono);letter-spacing:.16em;padding:8px 11px;cursor:pointer;pointer-events:auto;transition:.2s;
  text-transform:uppercase;white-space:nowrap;flex:none}
.btn:hover{color:var(--ink);border-color:#ffffff3d}
.btn .ic,.btn .ic-a,.btn .ic-b{display:inline-flex;width:14px;height:14px}
.btn svg{width:14px;height:14px}
.btn .ic-b{display:none}
.btn.on .ic-b{display:inline-flex}.btn.on .ic-a{display:none}
.btn.on{color:var(--grn);border-color:#3ddc8440}
#btnClip.on{color:#ff5a4a;border-color:#ff5a4a55}
#card{position:fixed;top:12vh;left:50%;transform:translateX(-50%);text-align:center;opacity:0;transition:.45s;pointer-events:none;z-index:12;width:min(90vw,700px)}
#card.show{opacity:1}
#card .k{font:500 10px var(--mono);letter-spacing:.3em;color:var(--mut)}
#card .t{font:400 clamp(46px,8vw,96px)/.95 var(--disp);letter-spacing:.02em;color:var(--ink);margin:10px 0 6px}
#card .s{font:400 11px/1.5 var(--mono);letter-spacing:.16em;color:var(--mut)}
#card svg{width:190px;height:34px;margin:12px auto 0;display:block}
#card.compact{top:8vh}
#card.compact .t,#card.compact .s{display:none}
#card.compact svg{width:130px;height:24px}
#verdict{position:fixed;top:40%;left:50%;transform:translate(-50%,-50%) scale(1.14);text-align:center;opacity:0;transition:.28s;z-index:13;pointer-events:none;width:min(92vw,900px)}
#verdict.show{opacity:1;transform:translate(-50%,-50%) scale(1)}
#verdict .t{font:400 clamp(40px,7vw,84px)/1 var(--disp);color:var(--ink)}
#verdict.bull .t{color:var(--grn)} #verdict.bear .t{color:var(--red)}
#verdict .s{font:500 11px/1.7 var(--mono);letter-spacing:.18em;color:var(--mut);margin-top:8px}
#movecard{position:fixed;top:33%;left:50%;transform:translate(-50%,-50%) rotate(-5deg) scale(1.55);opacity:0;z-index:14;pointer-events:none;text-align:center;transition:.22s cubic-bezier(.2,1.7,.4,1);width:92vw}
#movecard.show{opacity:1;transform:translate(-50%,-50%) rotate(-5deg) scale(1)}
#movecard .t{font:400 clamp(56px,10vw,124px)/1 var(--disp);letter-spacing:.03em;color:var(--ink)}
#movecard.bull .t{color:var(--grn)} #movecard.bear .t{color:var(--red)}
#movecard .s{font:500 10px var(--mono);letter-spacing:.3em;color:var(--mut)}
#flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:30}
#floaters{position:fixed;inset:0;pointer-events:none;z-index:8}
.float{position:fixed;left:0;top:0;font:600 13px var(--mono);color:var(--ink);text-shadow:0 2px 10px rgba(0,0,0,.95);white-space:nowrap;will-change:transform,opacity}
.float.up{color:var(--grn)} .float.dn{color:var(--red)}
.float.blk{color:#9aa0a6;font-size:10px;letter-spacing:.22em}
.float.vol{color:var(--gold);font-size:12px;letter-spacing:.18em}
.float.final{font:400 36px var(--disp)}
#log{position:fixed;left:16px;bottom:108px;z-index:9;display:flex;flex-direction:column;gap:4px;pointer-events:none}
.ll{font:400 10px var(--mono);color:#8b9096;background:rgba(8,9,11,.55);padding:3px 8px;animation:lfade 9s forwards}
.ll b{font-weight:600;margin-right:6px}
.ll.FEED b,.ll.CHART b{color:#7d838c}.ll.DIR b{color:var(--gold)}.ll.TEST b{color:var(--grn)}
.ll.UI b,.ll.SYS b{color:#9aa0a6}
@keyframes lfade{0%,72%{opacity:1}100%{opacity:0}}
#fps{position:fixed;left:16px;bottom:88px;font:400 9px var(--mono);color:#565b62;letter-spacing:.12em;z-index:9}
#countdown{position:fixed;bottom:88px;left:50%;transform:translateX(-50%);font:500 12px var(--mono);letter-spacing:.26em;color:var(--ink);opacity:0;transition:.3s;z-index:15}
#countdown.show{opacity:1}
.hl{outline:1px solid var(--gold);outline-offset:3px;animation:hlp .9s infinite alternate}
@keyframes hlp{from{outline-color:#d8a94e55}to{outline-color:#d8a94eff}}
#mini{position:fixed;right:16px;bottom:88px;width:310px;background:rgba(8,9,11,.72);border:1px solid var(--hair);z-index:15;pointer-events:none}
#mini .mh{display:flex;align-items:baseline;gap:10px;padding:7px 12px 2px;font:500 9px var(--mono);letter-spacing:.18em;color:var(--mut)}
#mini .mh b{color:var(--gold);font-weight:600}
#mini #miniD{margin-left:auto}
#mini .bigp{font:400 44px/1 var(--disp);padding:0 12px 4px;color:var(--ink)}
#mini .bigp.up{color:var(--grn)} #mini .bigp.dn{color:var(--red)}
#miniC{display:block;width:100%;height:44px}
#tut{position:fixed;top:15vh;left:50%;transform:translateX(-50%);z-index:26;width:min(520px,92vw);
  background:rgba(10,11,14,.93);border:1px solid var(--hair);padding:18px 22px;display:none;pointer-events:auto}
#tut.on{display:block;animation:tin .35s ease-out}
@keyframes tin{from{opacity:0;transform:translateX(-50%) translateY(14px)}to{opacity:1;transform:translateX(-50%)}}
.tut-step{font:600 9px var(--mono);letter-spacing:.3em;color:var(--gold)}
.tut-title{font:400 36px var(--disp);color:var(--ink);margin:4px 0 6px}
.tut-sub{font:400 11px/1.7 var(--mono);color:var(--mut);letter-spacing:.04em}
.tut-sub b{color:var(--ink)}
.tut-dots{display:flex;gap:6px;margin-top:12px}
.tut-dots i{width:20px;height:3px;background:#2a2f36}
.tut-dots i.a{background:var(--gold)}
#tutSkip{margin-top:12px}
#tutCandles{display:none;gap:18px;margin-top:14px;justify-content:center}
#tut.candles #tutCandles{display:flex}
.dc{display:flex;flex-direction:column;align-items:center;gap:6px;animation:cin .5s ease-out both}
.dc:nth-child(2){animation-delay:.15s}.dc:nth-child(3){animation-delay:.3s}
.dc .c{width:14px;height:36px;position:relative}
.dc .c i{position:absolute;left:6px;top:0;width:2px;height:36px;background:#8b9096}
.dc .c b{position:absolute;left:1px;top:9px;width:12px;height:18px;background:#555}
.dc.g .c b{background:var(--grn)} .dc.r .c b{background:var(--red)}
.dc.d .c b{height:3px;top:16px;background:#9aa0a6}
.dc span{font:500 8px var(--mono);letter-spacing:.2em;color:var(--mut)}
@keyframes cin{from{opacity:0;transform:translateY(10px)}to{opacity:1}}
#summary{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:22;background:rgba(6,7,9,.45);opacity:0;pointer-events:none;transition:.5s}
#summary.show{opacity:1;pointer-events:auto}
#summary .panel{width:min(560px,92vw);background:var(--panel);border:1px solid var(--hair);padding:30px 32px}
#summary .k{font:500 10px var(--mono);letter-spacing:.34em;color:var(--mut)}
#summary .t{font:400 clamp(42px,6vw,64px)/1 var(--disp);margin:10px 0 16px}
#sumStats{font:500 11px/2.2 var(--mono);letter-spacing:.14em;color:var(--mut);margin-bottom:20px}
#sumStats b{color:var(--ink);font-weight:600}
#sumStats .g{color:var(--grn)} #sumStats .r{color:var(--red)}
#summary .srow{display:flex;gap:10px;flex-wrap:wrap}
.btn.big{padding:12px 16px;font-size:10px}
#sharecard{position:fixed;inset:0;z-index:50;display:flex;align-items:center;justify-content:center;background:rgba(4,5,7,.82);opacity:0;pointer-events:none;transition:.3s}
#sharecard.show{opacity:1;pointer-events:auto}
#sharecard .panel{width:min(660px,94vw);background:var(--panel);border:1px solid var(--hair);padding:22px}
#sharecard .k{font:500 10px var(--mono);letter-spacing:.3em;color:var(--gold)}
#sharecard .t{font:400 46px var(--disp);margin:6px 0 14px}
#shVideo{width:100%;background:#000;border:1px solid var(--hair);display:block;max-height:48vh}
#shSize{font:500 10px var(--mono);color:var(--mut);letter-spacing:.14em;margin:10px 0 16px}
#sharecard .srow{display:flex;gap:10px;flex-wrap:wrap}
#overlay{position:fixed;inset:0;z-index:40;display:flex;align-items:center;justify-content:center;background:rgba(7,8,10,.62);backdrop-filter:blur(3px);transition:opacity .6s}
#overlay.gone{opacity:0;pointer-events:none}
.ov-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:54px;max-width:1080px;width:92%;align-items:center}
.ov-kick{font:500 11px var(--mono);letter-spacing:.34em;color:var(--mut)}
.ov-title{font:400 clamp(84px,14vw,190px)/.88 var(--disp);color:var(--ink);margin:14px 0 18px}
.ov-title em{font-style:normal;color:var(--red)}
.ov-sub{font:400 12px/1.9 var(--mono);color:var(--mut);letter-spacing:.05em;max-width:430px}
.ov-notes{list-style:none;margin:22px 0 0;font:500 10px/2.2 var(--mono);letter-spacing:.14em;color:#6d7278}
.ov-notes b{color:var(--grn);margin-right:6px} .ov-notes i{color:var(--red);font-style:normal;margin-right:6px}
.ov-right{background:var(--panel);border:1px solid var(--hair);padding:26px;display:flex;flex-direction:column;gap:16px}
.ov-field label{display:block;font:500 9px var(--mono);letter-spacing:.3em;color:var(--mut);margin-bottom:8px}
.seg{display:flex;border:1px solid var(--hair)}
.segbtn{flex:1;padding:11px 0;background:transparent;border:0;color:var(--mut);font:600 12px var(--mono);letter-spacing:.14em;cursor:pointer;transition:.15s}
.segbtn:hover{color:var(--ink)}
.segbtn.on{background:var(--ink);color:#0b0c0e}
#ovStatus{font:500 10px var(--mono);letter-spacing:.1em;color:#7d838c;min-height:13px}
.start{width:100%;padding:17px;background:var(--ink);color:#0b0c0e;border:0;font:600 13px var(--mono);letter-spacing:.32em;cursor:pointer;transition:.2s}
.start:hover{background:var(--grn)}
.ov-foot{font:400 9px/1.8 var(--mono);color:#565b62;letter-spacing:.06em}
.ov-foot a{color:#7d838c;cursor:pointer;text-decoration:underline;pointer-events:auto}
#tests{position:fixed;top:76px;right:0;width:310px;max-height:72vh;overflow:auto;background:rgba(10,11,13,.95);border:1px solid var(--hair);z-index:45;transform:translateX(105%);transition:.3s;padding:14px}
#tests.open{transform:none}
#tests .th{font:600 11px var(--mono);letter-spacing:.24em;color:var(--ink);margin-bottom:10px}
#tests .tr{font:400 10px/1.8 var(--mono);color:var(--mut);display:flex;gap:8px}
#tests .tr b{flex:none;width:10px;font-weight:600}
#tests .tr.ok b{color:var(--grn)} #tests .tr.bad b{color:var(--red)}
@media (max-width:1120px){.meters{display:none}}
@media (max-width:1000px){.wm-sub{display:none}}
@media (max-width:880px){#phaseTag{width:150px}.bl{display:none}.btn{padding:7px 8px}}
@media (max-width:780px){
  .lb{height:56px;padding:0 8px}
  .meters,#log,#fps{display:none}
  .ov-grid{grid-template-columns:1fr;gap:26px}
  .ov-title{font-size:clamp(64px,20vw,120px)}
  #countdown,#mini{bottom:64px}
  #mini{width:200px}
  #mini .bigp{font-size:30px}
  #miniC{height:32px}
  #tut{top:10vh}
}
</style>
</head>
<body>
<canvas id="gl"></canvas>
<div id="dimmer"></div>
<div id="flash"></div>
<div id="floaters"></div>
<div id="log"></div>
<div id="fps"></div>
<div id="countdown"></div>

<div id="mini">
  <div class="mh"><b id="miniPair">BTC</b><span id="miniSrc">1S TAPE · CB</span><span id="miniD"></span></div>
  <div class="bigp" id="bigP">—</div>
  <canvas id="miniC"></canvas>
</div>

<div class="lb top" id="lbT">
  <div class="lb-left">
    <div class="brandblock">
      <div class="wordmark">BAR<em>FIGHT</em></div>
      <div class="wm-sub">PRICE ACTION ARENA</div>
    </div>
    <div id="phaseTag">—</div>
    <div id="recTag"><i></i>REC</div>
  </div>
  <div class="lb-mid">
    <div id="roundNum">BOUT —</div>
    <div id="pairTag">—</div>
    <div id="modeTag">—</div>
  </div>
  <div class="lb-right">
    <div class="tk"><span class="led" id="ledCb"></span>CB <b id="cbP">—</b></div>
    <div class="tk"><span class="led" id="ledKr"></span>KR <b id="krP">—</b></div>
    <div class="tk">Δ <b id="spread">—</b></div>
    <div class="tk"><span class="led" id="ledFlow"></span>FLOW</div>
  </div>
</div>

<div class="lb bottom" id="lbB">
  <div class="meters">
    <div class="meter" id="mBull"><div class="mrow"><span class="mlab">BULL</span><span class="pips" id="pipsB">○○○○○</span></div><div class="pbar"><i id="pbB"></i></div></div>
    <div class="meter" id="mBear"><div class="mrow"><span class="mlab">BEAR</span><span class="pips" id="pipsR">○○○○○</span></div><div class="pbar"><i id="pbR"></i></div></div>
  </div>
  <div class="ctrl-wide">
    <button class="btn" id="btnPause" title="Pause [Space]"><span class="ic-a"><i data-lucide="pause"></i></span><span class="ic-b"><i data-lucide="play"></i></span><span class="bl">PAUSE</span></button>
    <button class="btn" id="btnSpeed" title="Playback speed [1/2/3]"><span class="ic"><i data-lucide="gauge"></i></span><span class="bl" id="speedLbl">1×</span></button>
    <button class="btn" id="btnCam" title="Manual orbit cam [C] — drag &amp; wheel"><span class="ic"><i data-lucide="video"></i></span><span class="bl" id="camLbl">AUTO CAM</span></button>
    <button class="btn" id="btnClip" title="Record this bout to a shareable clip [R]"><span class="ic"><i data-lucide="clapperboard"></i></span><span class="bl" id="clipLbl">CLIP BOUT</span></button>
    <button class="btn" id="btnSnd" title="Sound effects [M]"><span class="ic-a"><i data-lucide="volume-x"></i></span><span class="ic-b"><i data-lucide="volume-2"></i></span><span class="bl">SOUND</span></button>
    <button class="btn" id="btnVoice" title="Ring announcer voice [V]"><span class="ic"><i data-lucide="mic"></i></span><span class="bl">VOICE</span></button>
    <button class="btn" id="btnStats" title="Tape state panel [G]"><span class="ic"><i data-lucide="activity"></i></span><span class="bl">STATE</span></button>
    <button class="btn" id="btnTests" title="Self-test panel [T]"><span class="ic"><i data-lucide="list-checks"></i></span><span class="bl">CHECK</span></button>
  </div>
</div>

<div id="card">
  <div class="k" id="cardK"></div>
  <div class="t" id="cardT"></div>
  <div class="s" id="cardS"></div>
  <svg viewBox="0 0 120 26" preserveAspectRatio="none">
    <polyline id="cardPoly" fill="none" stroke="#ece7db" stroke-width="1" stroke-linejoin="round" opacity=".85" points=""/>
    <circle id="cardDot" r="1.7" fill="#8b9096" cx="-9" cy="-9"/>
  </svg>
</div>
<div id="verdict"><div class="t" id="verdictT"></div><div class="s" id="verdictS"></div></div>
<div id="movecard"><div class="t" id="moveT"></div><div class="s" id="moveS"></div></div>

<div id="tut">
  <div class="tut-step" id="tutStep">1/5</div>
  <div class="tut-title" id="tutT"></div>
  <div class="tut-sub" id="tutS"></div>
  <div id="tutCandles">
    <div class="dc g"><div class="c"><i></i><b></b></div><span>GREEN — BULL WINS</span></div>
    <div class="dc r"><div class="c"><i></i><b></b></div><span>RED — BEAR WINS</span></div>
    <div class="dc d"><div class="c"><i></i><b></b></div><span>DOJI — DOUBLE KO</span></div>
  </div>
  <div class="tut-dots" id="tutDots"></div>
  <button class="btn" id="tutSkip"><span class="ic"><i data-lucide="fast-forward"></i></span>SKIP THE BRIEFING</button>
</div>

<div id="summary"><div class="panel">
  <div class="k">TAPE STATE — LIVE SESSION</div>
  <div class="t" id="sumT"></div>
  <div id="sumStats"></div>
  <div class="srow">
    <button class="btn big" id="btnResume"><span class="ic"><i data-lucide="play"></i></span>RESUME THE BOUTS</button>
    <button class="btn big" id="btnRematch"><span class="ic"><i data-lucide="refresh-cw"></i></span>REMATCH — FRESH TAPE</button>
    <button class="btn big" id="btnMarkets"><span class="ic"><i data-lucide="repeat"></i></span>CHANGE MARKET</button>
  </div>
</div></div>

<div id="sharecard"><div class="panel">
  <div class="k">BOUT CLIP READY</div>
  <div class="t">SHARE THE FIGHT</div>
  <video id="shVideo" controls autoplay muted loop playsinline></video>
  <div id="shSize">—</div>
  <div class="srow">
    <button class="btn big" id="shDownload"><span class="ic"><i data-lucide="download"></i></span>DOWNLOAD CLIP</button>
    <button class="btn big" id="shShare"><span class="ic"><i data-lucide="share-2"></i></span>SHARE</button>
